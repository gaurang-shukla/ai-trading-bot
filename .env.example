TRADING_MODE=paper
DEFAULT_MARKET=crypto_futures
DEFAULT_VENUE=weex
DEFAULT_SYMBOL=BTCUSDT
WEEX_API_KEY=
WEEX_SECRET_KEY=
WEEX_PASSPHRASE=
# Signal ignores live-trading flags; this release can only execute on paper or WEEX demo.
WEEX_MAX_LEVERAGE=3
WEEX_MARGIN_TYPE=ISOLATED
PAPER_STARTING_CASH=100000
MAX_POSITION_PCT=0.05
MAX_ORDER_NOTIONAL=5000
MAX_DAILY_LOSS_PCT=0.02
MIN_CONFIDENCE=0.65
OPENBB_API_URL=http://127.0.0.1:6900
PAPERCLIP_API_URL=http://paperclip:3100
PAPERCLIP_API_KEY=
# Paperclip HTTP adapter target that accepts completed decision events.
PAPERCLIP_TASK_BRIDGE_URL=
# Random local secret used by Paperclip when calling /api/paperclip/analyze.
PAPERCLIP_BRIDGE_TOKEN=
PAPERCLIP_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SIGNAL_FAST_AI_MODEL=gpt-4o-mini
SIGNAL_FAST_AI_TIMEOUT_SECONDS=15
SIGNAL_DEEP_AI_TIMEOUT_SECONDS=180
SIGNAL_DEEP_AI_MAX_ROUNDS=1
SIGNAL_DEEP_AI_MAX_TOKENS=1200
# Optional lower-latency model for Advanced Deep Research.
SIGNAL_DEEP_AI_FAST_MODEL=
DEEP_ANALYSIS_CACHE_TTL_SECONDS=1200
# Maximum time Quick Signal waits for all candle timeframes before using partial/live-price data.
SIGNAL_QUICK_CANDLE_TIMEOUT_SECONDS=8
# Show raw provider and Deep AI timeout details only during local troubleshooting.
SIGNAL_DEBUG=false
AI_ANALYSIS_CACHE_TTL_SECONDS=600
MARKET_CACHE_TTL_SECONDS=60
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
SIGNAL_PORT=8787
